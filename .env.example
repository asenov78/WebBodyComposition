# Postgres (Neon via Vercel integration provides these automatically)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting Garmin/Xiaomi credentials at rest — 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared secret for pages/api/cron/sync.js — the external scheduler (see
# .github/workflows/sync-cron.yml) sends this in the x-cron-secret header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Resend API key — used by lib/email.js to send "forgot password" reset links.
# Sends from noreply@karolev.org (verified domain in Resend). Get a key at
# resend.com (API Keys -> Create).
RESEND_API_KEY=
