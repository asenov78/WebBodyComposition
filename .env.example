# Postgres (Neon via Vercel integration provides these automatically)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting Garmin credentials at rest — 64 hex chars (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
