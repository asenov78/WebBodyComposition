generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  garminCredential GarminCredential?
  measurements     Measurement[]
}

// Garmin login + reusable OAuth1 token, encrypted at rest (AES-256-GCM).
// Each *Enc field stores "iv:authTag:ciphertext" as produced by lib/encryption.js.
model GarminCredential {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnc      String
  passwordEnc   String
  accessTokenEnc String?
  tokenSecretEnc String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Imported from Xiaomi Cloud (or entered manually) and, once synced, pushed to Garmin.
// sourceDate is the actual weigh-in timestamp from the scale/cloud — unique per user so
// re-importing the same Xiaomi Cloud page twice doesn't create duplicate rows.
model Measurement {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceDate       DateTime?

  weight           Float
  bmi              Float?
  fat              Float?
  muscleMass       Float?
  waterPercentage  Float?
  boneMass         Float?
  visceralFat      Float?
  metabolicAge     Float?
  bodyType         Float?

  syncedToGarmin   Boolean   @default(false)
  syncError        String?
  createdAt        DateTime  @default(now())

  @@unique([userId, sourceDate])
}
