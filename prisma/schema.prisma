generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  garminCredential GarminCredential?
  xiaomiCredential XiaomiCredential?
  measurements     Measurement[]
  passwordResetTokens PasswordResetToken[]
}

// "Forgot password" flow. tokenHash is a SHA-256 hash of the token that's actually
// emailed to the user — the raw token never touches the database, same principle as
// a password hash, so a DB leak alone can't be used to reset anyone's account.
// One-time use (usedAt) and short-lived (expiresAt) by design.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())
}

// Xiaomi Cloud login (userId + passToken from the QR-code SSO flow), encrypted at rest.
// Saved once so the connection survives logout/incognito/other devices instead of
// living only in that one browser's localStorage.
model XiaomiCredential {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  xiaomiUserIdEnc String
  passTokenEnc    String
  region          String  @default("de")
  model           String  @default("yunmai.scales.ms104")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Garmin login + reusable OAuth1 token, encrypted at rest (AES-256-GCM).
// Each *Enc field stores "iv:authTag:ciphertext" as produced by lib/encryption.js.
model GarminCredential {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnc      String
  passwordEnc   String
  accessTokenEnc String?
  tokenSecretEnc String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Imported from Xiaomi Cloud (or entered manually) and, once synced, pushed to Garmin.
// sourceDate is the actual weigh-in timestamp from the scale/cloud — unique per user so
// re-importing the same Xiaomi Cloud page twice doesn't create duplicate rows.
model Measurement {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceDate       DateTime?

  weight           Float
  bmi              Float?
  fat              Float?
  muscleMass       Float?
  waterPercentage  Float?
  boneMass         Float?
  visceralFat      Float?
  metabolicAge     Float?
  bodyType         Float?

  syncedToGarmin   Boolean   @default(false)
  syncError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([userId, sourceDate])
}
